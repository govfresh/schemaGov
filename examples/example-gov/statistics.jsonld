        "@id": "https://example.gov/id/jurisdiction/example-city",
        "name": "Example City"
      },
      "license": "https://creativecommons.org/publicdomain/zero/1.0/",
      "dateModified": "2025-12-01",
      "distribution": [
        {
          "@type": "DataDownload",
          "name": "CSV",
          "contentUrl": "https://example.gov/data/community-survey-2024.csv",
          "encodingFormat": "text/csv"
        }
      ]
    },
    {
      "@id": "https://example.gov/id/area/statistical-area-0101",
      "@type": "Place",
      "name": "Statistical area 0101",
      "areaType": "statistical-area",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "gs:local",
          "value": "sa-0101"
        }
      ],
      "containedInPlace": {
        "@id": "https://example.gov/id/jurisdiction/example-city",
        "name": "Example City"
      }
    },
    {
      "@id": "https://example.gov/id/area/harbor-community",
      "@type": "Place",
      "name": "Harbor community area",
      "areaType": "community-area",
      "identifier": [
        {
          "@type": "PropertyValue",
          "propertyID": "gs:local",
          "value": "harbor"
        }
      ],
      "containedInPlace": {
        "@id": "https://example.gov/id/jurisdiction/example-city",
        "name": "Example City"
      },
      "geoOverlaps": [
        {
          "@id": "https://example.gov/id/area/statistical-area-0101",
          "name": "Statistical area 0101"
        }
      ]
    },
    {
      "@id": "https://example.gov/id/statistical-variable/population-total",
      "@type": "StatisticalVariable",
      "name": "Total population",
      "description": "Residents counted at their usual place of residence.",
      "populationType": "Person",
      "statType": "count"
    },
    {
      "@id": "https://example.gov/id/statistical-variable/population-65-plus",
      "@type": "StatisticalVariable",
      "name": "Population age 65 and over",
      "description": "Residents aged 65 or older.",
      "populationType": "Person",
      "statType": "count",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "propertyID": "age",
          "minValue": 65,
          "unitText": "year"
        }
      ]
    },
    {
      "@id": "https://example.gov/id/statistical-variable/median-household-income",
      "@type": "StatisticalVariable",
      "name": "Median household income",
      "description": "Median of annual household income, in current dollars. Households are the universe, not people.",
      "statType": "median"
    },
    {
      "@id": "https://example.gov/id/statistical-variable/households-total",
      "@type": "StatisticalVariable",
      "name": "Total households",
      "description": "Occupied housing units.",
      "statType": "count"
    },
    {
      "@id": "https://example.gov/id/statistical-variable/housing-cost-burden-rate",
      "@type": "StatisticalVariable",
      "name": "Housing cost burden rate",
      "description": "Share of households paying 30 percent or more of income on housing.",
      "statType": "percent",
      "measurementDenominator": {
        "@id": "https://example.gov/id/statistical-variable/households-total",
        "name": "Total households"
      }
    },
