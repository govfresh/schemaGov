{
  "@context": "https://schema.govfresh.com/v1/context.jsonld",
  "@graph": [
    {
      "@id": "https://example.gov/id/dataset/population-estimates",
      "@type": "Dataset",
      "name": "Annual population estimates",
      "description": "Resident population estimates by year, 2020 onward.",
