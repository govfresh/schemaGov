        "name": "Example City"
      },
      "license": "https://creativecommons.org/publicdomain/zero/1.0/",
      "dateModified": "2024-03-15",
      "distribution": [
        {
          "@type": "DataDownload",
          "name": "CSV",
          "contentUrl": "https://example.gov/data/population-estimates.csv",
          "encodingFormat": "text/csv"
        }
      ]
    },
    {
      "@id": "https://example.gov/id/dataset/community-survey-2024",
      "@type": "Dataset",
      "name": "Community survey, 2020-2024 estimates",
      "description": "Five-year estimates of population, income and housing for the city and its statistical areas.",
      "publisher": {
        "@id": "https://example.gov/id/organization/city-government",
        "name": "Example City Government"
      },
      "includedInDataCatalog": {
        "@id": "https://example.gov/id/catalog/open-data",
        "name": "Example City open data catalogue"
      },
