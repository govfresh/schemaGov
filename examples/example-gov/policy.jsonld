      "@id": "https://example.gov/id/policy/term/telework",
      "@type": "DefinedTerm",
      "name": "Telework",
      "termCode": "telework",
      "description": "Performing regular duties at an approved location other than the City worksite.",
      "inDefinedTermSet": "https://example.gov/id/policy/admin-policy-manual/ap-27/definitions",
      "subjectOf": [
        {
          "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.3"
