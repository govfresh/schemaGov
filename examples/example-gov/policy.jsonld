    {
      "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.1",
      "@type": "Legislation",
      "legislationType": "policy",
      "codificationLevel": "section",
      "legislationIdentifier": "27.1",
      "position": 1,
      "isPartOf": {
        "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27"
      },
      "text": "This policy sets the conditions under which an employee may work away from a City worksite.",
      "name": "Purpose"
    },
    {
      "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.2",
      "@type": "Legislation",
      "legislationType": "policy",
      "codificationLevel": "section",
      "legislationIdentifier": "27.2",
      "position": 2,
      "isPartOf": {
        "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27"
      },
      "text": "An employee is eligible to telework when all of the following apply:",
      "name": "Eligibility",
      "hasPart": [
        {
          "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.2.a"
        },
        {
          "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.2.b"
        }
      ]
    },
    {
      "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.2.a",
      "@type": "Legislation",
      "legislationType": "policy",
      "codificationLevel": "subsection",
      "legislationIdentifier": "(a)",
      "position": 1,
      "isPartOf": {
        "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.2"
      },
      "text": "The employee's supervisor has approved the arrangement in writing.",
      "hasPart": [
        {
          "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.2.a.1"
        },
        {
          "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.2.a.2"
        }
      ]
    },
    {
      "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.2.a.1",
      "@type": "Legislation",
      "legislationType": "policy",
      "codificationLevel": "paragraph",
      "legislationIdentifier": "(1)",
      "position": 1,
      "isPartOf": {
        "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.2.a"
      },
      "text": "The approval states the days on which the employee will telework.",
      "hasPart": [
        {
          "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.2.a.1.i"
        }
      ]
    },
    {
      "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.2.a.1.i",
      "@type": "Legislation",
      "legislationType": "policy",
      "codificationLevel": "paragraph",
      "legislationIdentifier": "(i)",
      "position": 1,
      "isPartOf": {
        "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.2.a.1"
      },
      "text": "Days may be changed only with the supervisor's written agreement."
    },
    {
      "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.2.a.2",
      "@type": "Legislation",
      "legislationType": "policy",
      "codificationLevel": "paragraph",
      "legislationIdentifier": "(2)",
      "position": 2,
      "isPartOf": {
        "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.2.a"
      },
      "text": "The approval is reviewed at least once a year."
    },
    {
      "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.2.b",
      "@type": "Legislation",
      "legislationType": "policy",
      "codificationLevel": "subsection",
      "legislationIdentifier": "(b)",
      "position": 2,
      "isPartOf": {
        "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.2"
      },
      "text": "The employee has completed the training required by AP 23."
    },
    {
      "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.3",
      "@type": "Legislation",
      "legislationType": "policy",
      "codificationLevel": "section",
      "legislationIdentifier": "27.3",
      "position": 3,
      "isPartOf": {
        "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27"
      },
      "text": "In this policy, \"Telework\" means performing regular duties at an approved location other than the City worksite.",
      "name": "Definitions"
    },
    {
      "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/definitions",
      "@type": "DefinedTermSet",
      "name": "AP 27 definitions",
      "hasDefinedTerm": [
        {
          "@id": "https://example.gov/id/policy/term/telework"
        }
      ]
    },
