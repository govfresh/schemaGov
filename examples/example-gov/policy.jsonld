          "@id": "https://example.gov/id/policy/admin-policy-manual/ap-27/27.3"
        }
      ],
      "description": "Sets out when and how employees may work away from a City worksite.",
      "url": "https://example.gov/policies/ap-27",
      "legislationDate": "2025-03-04",
      "legislationDateOfApplicability": "2025-04-01",
