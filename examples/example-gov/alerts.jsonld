          "urgency": "immediate",
          "severity": "severe",
          "certainty": "observed",
          "headline": "Boil water notice for District 2 following main break",
          "description": "A 12-inch water main failed overnight on 4th Street. Water pressure loss may have allowed contamination to enter the distribution system in District 2.",
          "instruction": "Boil all water used for drinking, cooking, or brushing teeth for at least one minute before use. Continue until this notice is lifted.",
          "effective": "2025-08-14T06:12:00-07:00",
          "onset": "2025-08-14T02:40:00-07:00",
          "expires": "2025-08-17T12:00:00-07:00",
