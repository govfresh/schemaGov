{
  "@context": "https://schema.govfresh.com/v1/context.jsonld",
  "@id": "https://schema.govfresh.com/v1/ElectionStatus",
  "@type": "DefinedTermSet",
  "name": "Election status",
  "description": "Whether an election is coming up, already happened, or didn't happen as planned. Cancelled and postponed elections stay on the record. An election that was called and then didn't happen is still part of the history.",
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "@id": "gs:electstatus/scheduled",
      "termCode": "scheduled",
      "name": "Scheduled",
      "description": "Called, but not yet held."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:electstatus/completed",
      "termCode": "completed",
      "name": "Completed",
      "description": "Held, with results reported."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:electstatus/cancelled",
      "termCode": "cancelled",
      "name": "Cancelled",
      "description": "Called, then never held."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:electstatus/postponed",
      "termCode": "postponed",
      "name": "Postponed",
      "description": "Pushed back to a later date."
    }
  ]
}
