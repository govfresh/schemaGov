{
  "@context": "https://schema.govfresh.com/v1/context.jsonld",
  "@id": "https://schema.govfresh.com/v1/Certainty",
  "@type": "DefinedTermSet",
  "name": "Certainty",
  "description": "How sure the sender is that the event will happen, or already did. Shown next to severity, so people can tell a shaky guess apart from something confirmed.",
  "url": "http://docs.oasis-open.org/emergency/cap/v1.2/CAP-v1.2-os.html",
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "@id": "gs:certainty/observed",
      "termCode": "observed",
      "name": "Observed",
      "description": "Confirmed to be happening or to have happened."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:certainty/likely",
      "termCode": "likely",
      "name": "Likely",
      "description": "More likely than not."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:certainty/possible",
      "termCode": "possible",
      "name": "Possible",
      "description": "Could happen, but isn't likely."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:certainty/unlikely",
      "termCode": "unlikely",
      "name": "Unlikely",
      "description": "Not expected to happen."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:certainty/unknown",
      "termCode": "unknown",
      "name": "Unknown",
      "description": "Not known."
    }
  ]
}
