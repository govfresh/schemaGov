{
  "@context": "https://schema.govfresh.com/v1/context.jsonld",
  "@id": "https://schema.govfresh.com/v1/Urgency",
  "@type": "DefinedTermSet",
  "name": "Urgency",
  "description": "How soon people need to act, using the same codes as CAP 1.2 (OASIS). Combined with severity and certainty, this tells a receiving system whether to interrupt someone right now.",
  "url": "http://docs.oasis-open.org/emergency/cap/v1.2/CAP-v1.2-os.html",
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "@id": "gs:urgency/immediate",
      "termCode": "immediate",
      "name": "Immediate",
      "description": "Act right away."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:urgency/expected",
      "termCode": "expected",
      "name": "Expected",
      "description": "Act soon, within the hour."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:urgency/future",
      "termCode": "future",
      "name": "Future",
      "description": "Act in the near future."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:urgency/past",
      "termCode": "past",
      "name": "Past",
      "description": "No longer needs a response."
    },
    {
      "@type": "DefinedTerm",
      "@id": "gs:urgency/unknown",
      "termCode": "unknown",
      "name": "Unknown",
      "description": "Not known."
    }
  ]
}
