<!doctype html>
<html lang="en" data-bs-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)">
{% if title %}{% assign pageTitle = title | append: " · " | append: site.title %}{% else %}{% assign pageTitle = site.title %}{% endif %}
{% assign pageDescription = description | default: site.description %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ site.url }}{{ canonicalUrl | default: page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/img/brand/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ pageTitle }}">

<!-- Dark mode: follow system preference, live (lf-ui's js/theme.js) — blocking and in <head> so the right theme is set before first paint. -->
<script src="/js/theme.js"></script>
{% include favicon.html %}
{% include style.html %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous">
</head>
<body class="d-flex flex-column min-vh-100">
<a href="#main" class="visually-hidden-focusable skip-link">Skip to main content</a>
{% include nav.html %}
<main id="main" class="flex-grow-1 pb-5">
  {{ content }}
</main>
{% include footer.html %}
