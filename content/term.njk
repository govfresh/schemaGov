---
layout: layouts/base.liquid
pagination:
  data: vocabulary.pages
  size: 1
  alias: entry
  addAllPagesToCollections: true
permalink: "/v1/{{ entry.spelling }}/"
eleventyComputed:
  title: "{{ entry.group.title | safe }}"
  description: "{{ entry.group.description | safe }}"
  canonicalUrl: "/v1/{{ entry.group.canonical }}/"
---
{#- Every spelling of a name that differs only by letter case renders this same group, so the
    page says the same thing whichever spelling is built last on a case-insensitive file system. -#}
{% set group = entry.group %}
<div class="container hero-xs">
  <div class="hero-divider pb-3 mb-4">
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/vocabulary/">Vocabulary</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{ group.title }}</li>
      </ol>
    </nav>
    <h1>{{ group.title }}</h1>
    {% if group.collision %}
    <p class="small text-body-secondary mb-0">These names differ only by letter case, so they share this page. Each one is a separate term with its own identifier.</p>
    {% endif %}
  </div>

  {% for m in group.members %}
  <section class="mb-5" id="{{ m.kind }}-{{ m.local }}">
    <h2 class="h4 mb-1"><code>gs:{{ m.local }}</code> <span class="badge text-bg-secondary align-middle fs-6">{{ m.kindLabel }}</span></h2>
    {% if m.comment %}<p class="mt-2">{{ m.comment | escape | linkifyTerms | inlineCode(profiles.built) | safe }}</p>{% endif %}

    <dl class="row small pt-2 mb-3">
      <dt class="col-sm-3">Identifier (IRI)</dt>
      <dd class="col-sm-9 font-secondary text-break mb-2">{{ m.iri }}</dd>
      {% if m.label and m.label != m.local %}
      <dt class="col-sm-3">Label</dt>
      <dd class="col-sm-9 mb-2">{{ m.label }}</dd>
      {% endif %}
      {% if m.subClassOf.length %}
      <dt class="col-sm-3">Subclass of</dt>
      <dd class="col-sm-9 mb-2">{% for r in m.subClassOf %}<a href="{{ r.href }}"><code>{{ r.text }}</code></a>{% if not loop.last %}, {% endif %}{% endfor %}</dd>
      {% endif %}
      {% if m.subPropertyOf.length %}
      <dt class="col-sm-3">Subproperty of</dt>
      <dd class="col-sm-9 mb-2">{% for r in m.subPropertyOf %}<a href="{{ r.href }}"><code>{{ r.text }}</code></a>{% if not loop.last %}, {% endif %}{% endfor %}</dd>
      {% endif %}
      {% if m.inverseOf.length %}
      <dt class="col-sm-3">Inverse of</dt>
      <dd class="col-sm-9 mb-2">{% for r in m.inverseOf %}<a href="{{ r.href }}"><code>{{ r.text }}</code></a>{% if not loop.last %}, {% endif %}{% endfor %}</dd>
      {% endif %}
      {% if m.domainIncludes.length %}
      <dt class="col-sm-3">Used on</dt>
      <dd class="col-sm-9 mb-2">{% for r in m.domainIncludes %}<a href="{{ r.href }}"><code>{{ r.text }}</code></a>{% if not loop.last %}, {% endif %}{% endfor %}</dd>
      {% endif %}
      {% if m.rangeIncludes.length %}
      <dt class="col-sm-3">Value</dt>
      <dd class="col-sm-9 mb-2">{% for r in m.rangeIncludes %}<a href="{{ r.href }}"><code>{{ r.text }}</code></a>{% if not loop.last %}, {% endif %}{% endfor %}</dd>
      {% endif %}
      {% if m.profile %}
      <dt class="col-sm-3">Profile</dt>
      <dd class="col-sm-9 mb-2"><a href="/profiles/{{ m.profile }}/">{{ m.profile }}</a></dd>
      {% elif m.section %}
      <dt class="col-sm-3">Section</dt>
      <dd class="col-sm-9 mb-2">{{ m.section }}</dd>
      {% endif %}
    </dl>

    {% if m.codelist %}
    {% set codelist = m.codelist %}
    {% if codelist.usedBy | length %}
    <p class="small text-body-secondary mb-3">Used by
      {% for u in codelist.usedBy %}<a href="/profiles/{{ u.profileSlug }}/#{{ u.schemaSlug }}">{{ u.schemaTitle }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.
    </p>
    {% endif %}
    <h3 class="h6 mb-3">Terms</h3>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead><tr><th style="width:18%">Code</th><th style="width:22%">Name</th><th>Description</th></tr></thead>
        <tbody>
          {% for t in codelist.terms %}
          <tr>
            <td>{% if t.path %}<a href="/v1/{{ t.path }}/"><code>{{ t.code }}</code></a>{% else %}<code>{{ t.code }}</code>{% endif %}</td>
            <td>{{ t.name }}</td>
            <td class="small">{{ t.description | linkifyTerms | inlineCode(profiles.built) | safe }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="input-group input-group-sm copy-field mb-3">
      <input type="text" class="form-control font-secondary" value="{{ codelist.id }}" readonly aria-label="Code list ID for {{ codelist.name }}">
      <button class="btn btn-secondary" type="button" data-copy><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor" style="width:0.85em;height:0.85em;vertical-align:-0.05em;margin-right:0.35em;"><path d="M208 0h124.1C344.8 0 357 5.1 366 14.1L433.9 82c9 9 14.1 21.2 14.1 33.9V336c0 26.5-21.5 48-48 48H208c-26.5 0-48-21.5-48-48V48c0-26.5 21.5-48 48-48zM48 128h80v64H64v256h192v-32h64v48c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V176c0-26.5 21.5-48 48-48z"/></svg><span class="copy-label">Copy</span></button>
    </div>
    <a href="/v1/codelists/{{ codelist.file }}" class="btn btn-secondary btn-sm"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor" style="width:0.85em;height:0.85em;vertical-align:-0.05em;margin-right:0.35em;"><path d="M208 0h124.1C344.8 0 357 5.1 366 14.1L433.9 82c9 9 14.1 21.2 14.1 33.9V336c0 26.5-21.5 48-48 48H208c-26.5 0-48-21.5-48-48V48c0-26.5 21.5-48 48-48zM48 128h80v64H64v256h192v-32h64v48c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V176c0-26.5 21.5-48 48-48z"/></svg><span class="copy-label">Copy</span></button>
  </div>
  <a href="/v1/codelists/{{ codelist.file }}" class="btn btn-secondary btn-sm mb-4"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor" style="width:0.85em;height:0.85em;vertical-align:-0.05em;margin-right:0.35em;"><path d="M288 32c0-17.7-14.3-32-32-32s-32 14.3-32 32v242.7l-73.4-73.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l128 128c12.5 12.5 32.8 12.5 45.3 0l128-128c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L288 274.7V32zM64 352c-35.3 0-64 28.7-64 64v32c0 35.3 28.7 64 64 64h384c35.3 0 64-28.7 64-64v-32c0-35.3-28.7-64-64-64H346.5l-45.3 45.3c-25 25-65.5 25-90.5 0L165.5 352H64zm368 56a24 24 0 1 1 0 48 24 24 0 1 1 0-48z"/></svg> Download JSON</a>
    {% endif %}
  </section>
  {% endfor %}

  <p class="small text-body-secondary mb-3">
    The full definition is in the <a href="/v1/schemagov.ttl">vocabulary file (Turtle)</a>. A static host
    cannot choose a format by request, so this page and that file are the two ways to read it.
  </p>
</div>
<script type="application/ld+json">
{{ group.jsonld | safe }}
</script>
<script src="/assets/lf-ui/copy-field.js" defer></script>
