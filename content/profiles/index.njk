---
layout: layouts/base.njk
title: Profiles
description: The areas of government work schemaGov covers, such as budgets, meetings, and legislation.
---
<div class="container hero-xs hero-divider">
  {% include "page-header.njk" %}
</div>

<div class="container pt-4">
  <div class="row g-3 mb-3 card-group">
    {% for b in profiles.built %}
    {% include "profile-card.njk" %}
    {% endfor %}
  </div>

  {% if profiles.planned | length %}
  <h2 class="h5 mb-3">Planned, in dependency order</h2>
  <p class="small text-body-secondary">Build order follows dependency, not interest.</p>
  <div class="list-group mb-4">
    {% for p in profiles.planned %}
    <div class="list-group-item">
      <h3 class="h6 mb-1"><code>{{ p.slug }}</code> — {{ p.title }}</h3>
      <p class="mb-1 small text-body-secondary">Standards: {{ p.source | linkifyTerms | safe }}<br>Depends on: <code>{{ p.depends }}</code></p>
      <p class="mb-0 small">status: <span class="badge text-bg-secondary">planned</span></p>
    </div>
    {% endfor %}
  </div>
  {% endif %}
</div>
