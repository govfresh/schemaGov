---
layout: layouts/base.njk
title: null
---
<div class="container hero-xs hero-divider pb-4 mb-5">
  <div class="row">
    <div class="col-lg-8">
      <h1 class="display-5 mb-3">A shared vocabulary for government operations</h1>
      <p class="lead mb-4">{{ site.description | safe }}</p>
      <p class="mb-4">
        <a href="/spec/" class="btn btn-primary">Specification</a>
        <a href="/profiles/" class="btn btn-primary ms-3">Profiles</a>
      </p>
      <p class="icon-line mb-1"><i class="fa-solid fa-tag"></i> Version: {{ site.version }}</p>
      <p class="icon-line mb-1 text-break"><i class="fa-solid fa-globe"></i> Namespace: {{ site.namespace }}</p>
      <p class="icon-line mb-1"><i class="fa-solid fa-code"></i> Prefix: {{ site.prefix }}</p>
      <p class="icon-line mb-0"><i class="fa-solid fa-scale-balanced"></i> Licence: <a href="{{ site.repo }}/blob/main/LICENSE">{{ site.licenseName }}</a> for the vocabulary and schemas, <a href="{{ site.repo }}/blob/main/LICENSE-CODE">MIT</a> for the tooling</p>
    </div>
  </div>
</div>

<div class="container">
  <h2 class="h4 mb-3">About</h2>
  <div class="row g-4 mb-5 card-group">
    <div class="col-md-4">
      <div class="card h-100"><div class="card-body">
        <div class="mb-2"><i class="fa-solid fa-puzzle-piece fa-2x" aria-hidden="true"></i></div>
        <h3 class="h5">A profile, not a new standard</h3>
        <p class="mb-0 small">Builds on schema.org and existing open standards, instead of inventing a new one.</p>
      </div></div>
    </div>
    <div class="col-md-4">
      <div class="card h-100"><div class="card-body">
        <div class="mb-2"><i class="fa-solid fa-door-open fa-2x" aria-hidden="true"></i></div>
        <h3 class="h5">Free for anyone to use</h3>
        <p class="mb-0 small">Public domain ({{ site.licenseName }}). Any government, vendor, or project can use it, free, without asking permission.</p>
      </div></div>
    </div>
    <div class="col-md-4">
      <div class="card h-100"><div class="card-body">
        <div class="mb-2"><i class="fa-solid fa-globe fa-2x" aria-hidden="true"></i></div>
        <h3 class="h5">Works across countries</h3>
        <p class="mb-0 small">No country's identifiers, government tiers, or naming conventions are built in, so it fits governments everywhere.</p>
      </div></div>
    </div>
  </div>

  <h2 class="h4 mb-1">Who this is for</h2>
  <p class="text-body-secondary mb-3">Who schemaGov supports.</p>
  <div class="row row-cols-2 row-cols-md-3 g-4 mb-5 card-group">
    <div class="col">
      <div class="card h-100"><div class="card-body">
        <div class="mb-2"><i class="fa-solid fa-briefcase fa-2x" aria-hidden="true"></i></div>
        <h3 class="h6 mb-0">Executives</h3>
      </div></div>
    </div>
    <div class="col">
      <div class="card h-100"><div class="card-body">
        <div class="mb-2"><i class="fa-solid fa-clipboard-list fa-2x" aria-hidden="true"></i></div>
        <h3 class="h6 mb-0">Service managers</h3>
      </div></div>
    </div>
    <div class="col">
      <div class="card h-100"><div class="card-body">
        <div class="mb-2"><i class="fa-solid fa-code fa-2x" aria-hidden="true"></i></div>
        <h3 class="h6 mb-0">Digital teams</h3>
      </div></div>
    </div>
    <div class="col">
      <div class="card h-100"><div class="card-body">
        <div class="mb-2"><i class="fa-solid fa-handshake fa-2x" aria-hidden="true"></i></div>
        <h3 class="h6 mb-0">Vendors</h3>
      </div></div>
    </div>
    <div class="col">
      <div class="card h-100"><div class="card-body">
        <div class="mb-2"><i class="fa-solid fa-landmark fa-2x" aria-hidden="true"></i></div>
        <h3 class="h6 mb-0">Policy makers</h3>
      </div></div>
    </div>
    <div class="col">
      <div class="card h-100"><div class="card-body">
        <div class="mb-2"><i class="fa-solid fa-chart-line fa-2x" aria-hidden="true"></i></div>
        <h3 class="h6 mb-0">Analysts</h3>
      </div></div>
    </div>
  </div>

  <h2 class="h4 mb-1">Profiles</h2>
  <p class="text-body-secondary mb-3">Domain profiles schemaGov has built so far.</p>
  <div class="row g-3 mb-5 card-group">
    {% for b in profiles.built %}
    {% include "profile-card.njk" %}
    {% endfor %}
    {% for p in profiles.planned %}
    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-body">
          <h3 class="h5 mb-2">{{ p.title }}</h3>
          <span class="badge text-bg-secondary">planned</span>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>

</div>
