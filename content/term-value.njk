---
layout: layouts/base.njk
pagination:
  data: profiles.terms
  size: 1
  alias: term
  addAllPagesToCollections: true
permalink: "/v1/{{ term.path }}/"
eleventyComputed:
  title: "{{ term.name | safe }}"
  description: "{{ term.description | safe }}"
---
<div class="container hero-xs">
  <div class="hero-divider pb-3 mb-4">
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/vocabulary/">Vocabulary</a></li>
        <li class="breadcrumb-item"><a href="/v1/{{ term.setSegment }}/">{{ term.setName }}</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{ term.code }}</li>
      </ol>
    </nav>

    {% include "page-header.njk" %}

    <dl class="row small pt-3 mb-0">
      <dt class="col-sm-3">Code</dt>
      <dd class="col-sm-9 font-secondary mb-2">{{ term.code }}</dd>
      <dt class="col-sm-3">Full identifier (IRI)</dt>
      <dd class="col-sm-9 font-secondary text-break mb-2">{{ site.namespace }}{{ term.path }}</dd>
      <dt class="col-sm-3">Part of</dt>
      <dd class="col-sm-9 mb-2"><a href="/v1/{{ term.setSegment }}/">{{ term.setName }}</a></dd>
      <dt class="col-sm-3">JSON file</dt>
      <dd class="col-sm-9 mb-2"><a href="/v1/codelists/{{ term.file }}" class="font-secondary">/v1/codelists/{{ term.file }}</a></dd>
      <dt class="col-sm-3">Profile</dt>
      <dd class="col-sm-9 mb-0"><a href="/profiles/{{ term.profile }}/">{{ term.profile }}</a></dd>
    </dl>
  </div>

  <p class="small text-body-secondary mb-0 mt-4">
    A document only ever uses the short code above (<code>{{ term.code }}</code>). The full identifier
    is just its complete, globally unique form, so any system reading it knows exactly which term is meant.
  </p>
</div>
